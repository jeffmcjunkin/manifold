  "globals": {
    "_comment": "Header-declared / libc global VARIABLES. 'kind' derives the emitter's per-global policy sets: stdio_file (keep real name, emit no definition -- <stdio.h> binds to libc), libc_extern (keep real name, emit extern -- binds to libc), reserved_rename (rename <name>_sym -- the recovered global is a program copy that must not collide with the libc symbol). 'type' (optional) is the canonical C spelling the emitter must use for the declaration, so our extern matches the header/libc.",
    "stdin": { "kind": "stdio_file" },
    "stdout": { "kind": "stdio_file" },
    "stderr": { "kind": "stdio_file" },
    "optind": { "kind": "libc_extern", "type": "int" },
    "optarg": { "kind": "libc_extern", "type": "char *" },
    "opterr": { "kind": "libc_extern", "type": "int" },
    "optopt": { "kind": "libc_extern", "type": "int" },
    "environ": { "kind": "libc_extern", "type": "char **" },
    "__environ": { "kind": "canonical_type", "type": "char **" },
    "errno": { "kind": "reserved_rename" },
    "program_invocation_name": { "kind": "reserved_rename" },
    "program_invocation_short_name": { "kind": "reserved_rename" }
  },
  "local_definitions": {
    "_comment": "Policy for functions the binary DEFINES under a header-declared name (glibc static shims from libc_nonshared.a, gnulib replacements compiled in under the libc name). The definition itself would be a 'conflicting types' error, so each name is classified: 'filter' = do NOT emit the definition; call sites bind to the system header's declaration (correct when the local body IS the libc behavior, e.g. the atexit shim that just forwards to __cxa_atexit). 'decompile' = emit the definition renamed to <name>_local with all TU-internal references following (correct when the local body may genuinely differ from libc). A header-colliding definition listed in NEITHER set defaults to 'decompile' -- code is never silently dropped without a curated decision here.",
    "filter": ["atexit"],
    "decompile": []
  },
  "prefixes": ["__builtin_"]
}
